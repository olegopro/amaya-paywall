    "eslint": "^10.12.0",
    "storybook": "^10.6.2",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
